  [ "${lines[9]}" = "$help_mktar_9" ]
  [ "${lines[10]}" = "$help_mktar_10" ]
  [ "${lines[11]}" = "$help_mktar_11" ]
  [ "${lines[12]}" = "$help_mktar_12" ]
  [ "${lines[13]}" = "$help_mktar_13" ]
  [ "$stderr" = "" ]
}
