#!/usr/bin/env bats
bats_require_minimum_version 1.5.0
load fixtures.sh
@test "mktar (flags: -h)" {
  run --separate-stderr ./mktar -h
  [ "$status" -eq 0 ]
  [ "${lines[0]}" = "$help_mktar_0" ]
  [ "${lines[1]}" = "$help_mktar_1" ]
  [ "${lines[2]}" = "$help_mktar_2" ]
  [ "${lines[3]}" = "$help_mktar_3" ]
  [ "${lines[4]}" = "$help_mktar_4" ]
  [ "${lines[5]}" = "$help_mktar_5" ]
